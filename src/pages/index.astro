---
import "../styles/global.css";

const modules = [
  { num: "01", title: "Job management", desc: "Track every job from first call to final payment. Nothing falls through the cracks." },
  { num: "02", title: "Quoting", desc: "Build and send professional quotes from your phone before you leave the customer." },
  { num: "03", title: "Invoicing", desc: "Invoice the moment the job is done. No more chasing paperwork at the end of the week." },
  { num: "04", title: "Expenses", desc: "Photograph receipts on-site. Every cost tracked without a spreadsheet in sight." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Dulo is the all-in-one operations tool built for sole traders and small trades businesses. Quotes, invoices, jobs, and expenses — one app, not four."
    />
    <title>Dulo | One app to run your trades business</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Dulo home">
        <span class="brand-mark">D</span>
        <span>Dulo</span>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#what">What it replaces</a>
        <a href="#who">Who it's for</a>
      </nav>
      <a class="header-cta" href="https://tally.so/r/vGJ6yg">Join the waitlist</a>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-copy">
          <h1>One app to run your trades business.</h1>
          <p class="hero-lede">
            Dulo replaces the stack of apps and spreadsheets sole traders use to quote, invoice, track expenses, and manage jobs. Simple enough to use on-site. Cheap enough to justify on day one.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://tally.so/r/vGJ6yg">Join the waitlist</a>
            <a class="button button-secondary" href="#what">See what it replaces</a>
          </div>
          <dl class="proof-strip" aria-label="Dulo key facts">
            <div>
              <dt>4</dt>
              <dd>Tools replaced</dd>
            </div>
            <div>
              <dt>1–3</dt>
              <dd>Person teams</dd>
            </div>
            <div>
              <dt>Free</dt>
              <dd>To get started</dd>
            </div>
          </dl>
        </div>

        <div class="workflow-panel" aria-label="Job management preview">
          <div class="panel-topline">
            <span>Job overview</span>
            <span class="status-dot" data-status-badge>In Progress</span>
          </div>
          <div class="invoice-card">
            <div>
              <span class="label">Client</span>
              <strong>Hargreaves & Sons</strong>
            </div>
            <div>
              <span class="label">Value</span>
              <strong>£840</strong>
            </div>
            <div>
              <span class="label">Booked</span>
              <strong>Today</strong>
            </div>
          </div>
          <div class="tone-row" aria-label="Job status">
            <button class="tone" type="button" data-status="Quoted" aria-pressed="false">Quoted</button>
            <button class="tone active" type="button" data-status="In Progress" aria-pressed="true">In Progress</button>
            <button class="tone" type="button" data-status="Invoiced" aria-pressed="false">Invoiced</button>
          </div>
          <div class="message-preview">
            <span class="label">Linked items</span>
            <p data-linked-items>Quote #Q-041 sent · Invoice pending</p>
          </div>
          <div class="next-step">
            <span>Next action</span>
            <strong data-next-action>Send invoice on completion</strong>
          </div>
        </div>
      </section>

      <section class="problem section-shell">
        <div>
          <h2>Four apps is four too many.</h2>
        </div>
        <div class="problem-copy">
          <p>
            Most sole traders run their business across a mix of spreadsheets, email threads, and single-purpose apps — one for invoicing, one for quoting, another for expenses.
          </p>
          <p>
            The proper all-in-one tools (Jobber, ServiceM8, Tradify) are built for larger teams: complex to set up, expensive, and overkill for someone running 10 jobs a week. Dulo is built for everyone else.
          </p>
        </div>
      </section>

      <section class="steps section-shell" id="what">
        <div class="section-heading">
          <h2>Everything you need. Nothing you don't.</h2>
          <p>Dulo brings four core parts of your operation into one place.</p>
        </div>
        <div class="step-list">
          {modules.map((m) => (
            <article>
              <span>{m.num}</span>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="pricing section-shell" id="early-access">
        <div class="section-heading">
          <h2>Join the waitlist</h2>
          <p>We're building Dulo for sole traders and small trades teams who are sick of juggling tools. Join the waitlist and help us build the right thing.</p>
        </div>
        <div class="early-access-benefits">
          <ul>
            <li>Early access before public launch</li>
            <li>Help shape what we build first</li>
            <li>Locked-in early access pricing</li>
          </ul>
          <a class="button button-primary" href="https://tally.so/r/vGJ6yg">Join the waitlist</a>
        </div>
      </section>

      <section class="outreach section-shell" id="who">
        <div class="section-heading align-left">
          <h2>Who Dulo is for</h2>
          <p>Sole traders and small trades teams who want one tool, not four.</p>
        </div>
        <div class="script-box">
          <p>You're a plumber, electrician, HVAC contractor, builder, cleaner, or landscaper — running a 1 to 3 person operation.</p>
          <p>You quote jobs over the phone, invoice from memory, and track expenses in a notes app or not at all.</p>
          <p>You've looked at Jobber or ServiceM8 and thought: this is way more than I need, and way more than I want to pay.</p>
          <p>Dulo is for you. Join the waitlist and help us get it right.</p>
        </div>
      </section>

      <section class="final-cta section-shell">
        <div>
          <h2>Join the waitlist.</h2>
          <p>Tell us what you currently use to run your business and get early access when we launch.</p>
        </div>
        <a class="button button-primary" href="https://tally.so/r/vGJ6yg">Join the waitlist</a>
      </section>
    </main>

    <script>
      const statusData: Record<string, { linked: string; next: string }> = {
        "Quoted": {
          linked: "Quote #Q-041 sent · Awaiting approval",
          next: "Follow up if no response by Friday"
        },
        "In Progress": {
          linked: "Quote #Q-041 sent · Invoice pending",
          next: "Send invoice on completion"
        },
        "Invoiced": {
          linked: "Quote #Q-041 · Invoice #I-108 sent",
          next: "Mark paid when payment arrives"
        }
      };

      const statusButtons = document.querySelectorAll<HTMLButtonElement>("[data-status]");
      const statusBadge = document.querySelector("[data-status-badge]");
      const linkedItems = document.querySelector("[data-linked-items]");
      const nextAction = document.querySelector("[data-next-action]");

      statusButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selected = button.getAttribute("data-status");
          if (!selected || !statusBadge || !linkedItems || !nextAction) return;

          statusButtons.forEach((btn) => {
            btn.classList.toggle("active", btn === button);
            btn.setAttribute("aria-pressed", String(btn === button));
          });

          statusBadge.textContent = selected;
          linkedItems.textContent = statusData[selected].linked;
          nextAction.textContent = statusData[selected].next;
        });
      });
    </script>
  </body>
</html>
